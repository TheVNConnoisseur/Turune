<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:vm="using:Turune.ViewModels.Tools.Scripts"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia.Tight"
             xmlns:lang="using:Turune.Localizations"
             x:Class="Turune.Views.Tools.Scripts.SDTDecompileView"
             x:DataType="vm:SDTDecompileViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,Auto" Margin="20">

        <!-- Input file selection -->
        <GroupBox VerticalAlignment="Center" Header="Input selection" Margin="20" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="1">
            <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,Auto">
                <!-- Button to select input files -->
                <Button Grid.Row="0" Margin="0,10,0,20" Command="{Binding SelectInputCommand}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource Bootstrap.Folder2 open}" Width="16" />
                        <TextBlock Text="Select" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
                
                <!-- Panel that reports the file parsing process -->
                <Panel Width="250" Grid.Row="1">
                    <StackPanel IsVisible="{Binding IsBusy}" Spacing="4">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Margin="10,0,10,0" />
                        <TextBlock Text="{Binding Progress, StringFormat='{}{0:0}%'}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    </StackPanel>
                    <TextBlock Text="{Binding FileIOStatus}" IsVisible="{Binding !IsBusy}" FontSize="13" TextWrapping="Wrap"
                            HorizontalAlignment="Center" TextAlignment="Center" Margin="10,0,10,10"/>
                </Panel>
            </Grid>
        </GroupBox>

        <!-- Export properties -->
        <GroupBox VerticalAlignment="Center" Header="Export properties" Margin="20" Grid.Row="0" Grid.Column="1" IsEnabled="{Binding IsReady}">
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" Margin="20">

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,30,12" VerticalAlignment="Center"
                    Text="Encoding">
                    <ToolTip.Tip>
                        <md:MarkdownScrollViewer Markdown="Indicates if the file should be encrypted or not."/>
                    </ToolTip.Tip>
                </TextBlock>
                <ComboBox VerticalAlignment="Center" Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailableEncodings}"
                    SelectedItem="{Binding SelectedEncoding}"
                    DisplayMemberBinding="{Binding DisplayName}" />
            </Grid>
        </GroupBox>
        

        <!-- Navigation buttons -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
            <Button Content="←  Back" IsEnabled="{Binding !IsBusy}" Command="{Binding GoBackCommand}"/>
            <Button Command="{Binding DecompileCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource Bootstrap.Floppy}" Width="16" />
                    <TextBlock Text="Export all" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>