<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Turune.ViewModels.Tools.Containers"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia.Tight"
             xmlns:lang="using:Turune.Localizations"
             x:Class="Turune.Views.Tools.Containers.ODNCreateView"
             x:DataType="vm:ODNCreateViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,Auto" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">

         <!-- ODN properties -->
        <GroupBox Header="{x:Static lang:Resources.ODN_Properties}" Margin="20" Grid.Row="0">
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" Margin="20">

                <md:MarkdownScrollViewer Grid.Row="0" Grid.Column="0"
                    Markdown="{x:Static lang:Resources.ODN_IsEncrypted}"
                    Margin="0,0,30,12"
                    VerticalAlignment="Center"/>
                <ToggleSwitch Grid.Row="0" Grid.Column="1"
                    IsChecked="{Binding IsEncrypted}"
                    OnContent="{x:Static lang:Resources.CommonTerms_Yes}" OffContent="{x:Static lang:Resources.CommonTerms_No}"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Right"/>

                <md:MarkdownScrollViewer Grid.Row="1" Grid.Column="0"
                    Markdown="{x:Static lang:Resources.ODN_EntriesOffsets}"
                    Margin="0,0,30,12"
                    VerticalAlignment="Center"/>
                <ToggleSwitch Grid.Row="1" Grid.Column="1"
                    IsChecked="{Binding EntriesOffsetsAreRelativeToRawData}"
                    OnContent="{x:Static lang:Resources.CommonTerms_Yes}"
                    OffContent="{x:Static lang:Resources.CommonTerms_No}"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Right"/>

                <md:MarkdownScrollViewer Grid.Row="2" Grid.Column="0"
                    Markdown="{x:Static lang:Resources.ODN_HasIndexDelimiter}"
                    Margin="0,0,30,12"
                    VerticalAlignment="Center"/>
                 <ToggleSwitch Grid.Row="2" Grid.Column="1"
                    IsChecked="{Binding HasDelimiterEntryOffset}"
                    OnContent="{x:Static lang:Resources.CommonTerms_Yes}"
                    OffContent="{x:Static lang:Resources.CommonTerms_No}"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Right"/>
            </Grid>
        </GroupBox>
        
        <TextBox Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Grid.ColumnSpan="2" Text="TEST for something else"/>

        <!-- Navigation buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="8">
            <Button Content="←  Back"
                    Command="{Binding GoBackCommand}" />
            <Button Content="Create ODN file"
                    Command="{Binding CreateCommand}" />
        </StackPanel>
    </Grid>
</UserControl>