<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Turune.ViewModels.Tools.Containers"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia.Tight"
             xmlns:lang="using:Turune.Localizations"
             x:Class="Turune.Views.Tools.Containers.ODNCreateView"
             x:DataType="vm:ODNCreateViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,Auto" Margin="20">
        
        <!-- Input folder selection -->
        <GroupBox VerticalAlignment="Center" Header="Input selection" Margin="20" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="1">
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                <!-- Button to select folder with files to compress -->
                <Button Grid.Row="0" Margin="0,10,0,20" Command="{Binding SelectInputFolderCommand}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource Bootstrap.Folder2 open}" Width="16" />
                        <TextBlock Text="Select" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
                
                <!-- Panel that reports the file parsing process -->
                <Panel Width="250" Grid.Row="1">
                    <StackPanel IsVisible="{Binding IsBusy}" Spacing="4">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Margin="10,0,10,0" />
                        <TextBlock Text="{Binding Progress, StringFormat='{}{0:0}%'}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    </StackPanel>

                    <TextBlock Text="{Binding ODNParsingStatus}" IsVisible="{Binding !IsBusy}" FontSize="13" TextWrapping="Wrap"
                            HorizontalAlignment="Center" TextAlignment="Center" Margin="10,0,10,10"/>
                </Panel>
            </Grid>
        </GroupBox>

        <!-- ODN properties -->
        <GroupBox VerticalAlignment="Center" Header="{x:Static lang:Resources.ODN_Properties}" Margin="20" Grid.Row="0" Grid.Column="1" IsEnabled="{Binding IsODNCreationReady}">
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" Margin="20">

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,30,12" VerticalAlignment="Center"
                    Text="{x:Static lang:Resources.ODN_IsEncrypted}">
                    <ToolTip.Tip>
                        <md:MarkdownScrollViewer Markdown="Indicates if the file should be encrypted or not."/>
                    </ToolTip.Tip>
                </TextBlock>
                <ToggleSwitch Grid.Row="0" Grid.Column="1"
                    IsChecked="{Binding IsEncrypted}"
                    OnContent="{x:Static lang:Resources.CommonTerms_Yes}" OffContent="{x:Static lang:Resources.CommonTerms_No}"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Right"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                    Text="{x:Static lang:Resources.ODN_EntriesOffsets}"
                    Margin="0,0,30,12"
                    VerticalAlignment="Center">
                    <ToolTip.Tip>
                        <md:MarkdownScrollViewer Markdown="If set to *Yes*, the offsets all entries will be relative to the offset of the raw data section, meaning that the first entry will be at offset 0."/>
                    </ToolTip.Tip>
                </TextBlock>
                <ToggleSwitch Grid.Row="1" Grid.Column="1"
                    IsChecked="{Binding EntriesOffsetsAreRelativeToRawData}"
                    OnContent="{x:Static lang:Resources.CommonTerms_Yes}"
                    OffContent="{x:Static lang:Resources.CommonTerms_No}"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Right"/>

                <TextBlock Grid.Row="2" Grid.Column="0"
                    Text="{x:Static lang:Resources.ODN_HasIndexDelimiter}"
                    Margin="0,0,30,12"
                    VerticalAlignment="Center">
                    <ToolTip.Tip>
                        <md:MarkdownScrollViewer Markdown="If set to *Yes*, a delimiter entry will be created at the end of the index, which will let the game know that the index has ended."/>
                    </ToolTip.Tip>
                </TextBlock>
                 <ToggleSwitch Grid.Row="2" Grid.Column="1"
                    IsChecked="{Binding HasDelimiterEntryOffset}"
                    OnContent="{x:Static lang:Resources.CommonTerms_Yes}"
                    OffContent="{x:Static lang:Resources.CommonTerms_No}"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Right"/>
            </Grid>
        </GroupBox>

        <!-- Navigation buttons -->
        <StackPanel Grid.Row="2"
            Grid.ColumnSpan="2"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Spacing="8">
            <Button Content="←  Back" IsEnabled="{Binding !IsBusy}" Command="{Binding GoBackCommand}"/>
            <Button IsEnabled="{Binding IsODNCreationReady}" Command="{Binding CreateCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource Bootstrap.Floppy}" Width="16" />
                    <TextBlock Text="Save ODN file" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>