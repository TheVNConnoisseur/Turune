<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:vm="using:Turune.ViewModels.Tools.Containers"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Turune.Views.Tools.Containers.ODNCreateView"
             x:DataType="vm:ODNCreateViewModel">

    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="Simple view for navigation" FontSize="20" FontWeight="Bold" />
        <Button Content="Go Back" Command="{Binding GoBackCommand}" />
        <Button Content="Test" Command="{Binding CreateCommand}" />
    </StackPanel>

</UserControl>