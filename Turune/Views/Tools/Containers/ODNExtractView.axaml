<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:vm="using:Turune.ViewModels.Tools.Containers"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia.Tight"
             xmlns:lang="using:Turune.Localizations"
             x:Class="Turune.Views.Tools.Containers.ODNExtractView"
             x:DataType="vm:ODNExtractViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,Auto" Margin="20">

        <!-- Input file selection -->
        <GroupBox VerticalAlignment="Center" Header="Input selection" Margin="20" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="1">
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                <!-- Button to select file with files to extract -->
                <Button Grid.Row="0" Margin="0,10,0,20" Command="{Binding SelectInputFileCommand}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource Bootstrap.Folder2 open}" Width="16" />
                        <TextBlock Text="Select" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
                
                <!-- Panel that reports the file parsing process -->
                <Panel Width="250" Grid.Row="1">
                    <ProgressBar IsVisible="{Binding IsBusy}" Minimum="0" Maximum="100" IsIndeterminate="True" Margin="10,0,10,10" />
                    <TextBlock Text="{Binding FileIOStatus}" IsVisible="{Binding !IsBusy}" FontSize="13" TextWrapping="Wrap"
                            HorizontalAlignment="Center" TextAlignment="Center" Margin="10,0,10,10"/>
                </Panel>
            </Grid>
        </GroupBox>

        <!-- ODN properties -->
        <GroupBox VerticalAlignment="Center" Header="{x:Static lang:Resources.ODN_Properties}" Margin="20" Grid.Row="0" Grid.Column="1" IsEnabled="{Binding IsReady}">
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" Margin="20">

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,30,12" VerticalAlignment="Center"
                    Text="{x:Static lang:Resources.ODN_IsEncrypted}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding IsEncrypted}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,30,12" VerticalAlignment="Center"
                    Text="{x:Static lang:Resources.ODN_EntriesOffsets}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EntriesOffsetsAreRelativeToRawData}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,30,12" VerticalAlignment="Center"
                    Text="{x:Static lang:Resources.ODN_HasIndexDelimiter}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HasDelimiterEntry}" />
            </Grid>
        </GroupBox>

        <!-- Navigation buttons -->
        <StackPanel Grid.Row="2"
            Grid.ColumnSpan="2"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Spacing="8">
            <Button Content="←  Back" IsEnabled="{Binding !IsBusy}" Command="{Binding GoBackCommand}"/>
            <Button IsEnabled="{Binding IsReady}" Command="{Binding ExtractCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource Bootstrap.Floppy}" Width="16" />
                    <TextBlock Text="Export files" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>