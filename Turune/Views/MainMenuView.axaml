<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Turune.ViewModels"
             xmlns:models="using:Turune.Models"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia.Tight"
             x:Class="Turune.Views.MainMenuView"
             x:DataType="vm:MainMenuViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto" Margin="20" HorizontalAlignment="Center">

        <TextBlock Grid.Row="0"
                   Text="{Binding Title}"
                   FontSize="40"
                   Margin="0,40,0,50"
                   HorizontalAlignment="Center" />

        <ListBox Grid.Row="1"
                 SelectionMode="AlwaysSelected"
                 ItemsSource="{Binding Options}"
                 SelectedItem="{Binding SelectedOption}"
                 HorizontalAlignment="Center">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="models:MenuOption">
                    <TextBlock Text="{Binding Key}"
                               HorizontalAlignment="Center" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <md:MarkdownScrollViewer Grid.Row="2"
                                 Markdown="{Binding SelectedOption.Description}"
                                 Margin="0,12"
                                 MaxWidth="650"/>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Content="Back"
                    Command="{Binding GoBackCommand}"
                    IsVisible="{Binding CanGoBack}" />
            <Button Content="Next"
                    Command="{Binding NextCommand}" />
        </StackPanel>

    </Grid>
</UserControl>