<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Turune.App"
             xmlns:local="using:Turune"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <x:String x:Key="AppName">Turune</x:String>
        <FontFamily x:Key="OutfitFont">avares://Turune/Assets/Fonts#Outfit</FontFamily>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{StaticResource OutfitFont}" />
        </Style>
    </Application.Styles>
</Application>